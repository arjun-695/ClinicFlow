PORT=8080
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres?sslmode=disable
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_BUCKET_NAME=receipts
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000
SESSION_SECRET=generate_a_64_char_hex_string
SHOP_NAME=Your Shop Name
SHOPKEEPER_PHONE=your_phone_with_country_code


# Background Notification Worker (set to true to disable automatic WhatsApp reminders during local development)
DISABLE_NOTIFICATION_WORKER=true

# SMTP Configuration (for sending emails via Gmail or other SMTP server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
